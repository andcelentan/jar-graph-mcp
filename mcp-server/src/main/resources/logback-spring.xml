<?xml version="1.0" encoding="UTF-8"?>
<!--
  STDIO transport (ADR-0009): standard output is reserved for MCP JSON-RPC messages, so every log line goes to
  standard error. Same appender as Spring Boot's console-appender.xml, with an explicit System.err target.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
